   "source": [
    "from qiskit import QuantumCircuit\n",
    "from qiskit_aer import AerSimulator\n",
    "\n",
    "\n",
    "qc=QuantumCircuit(2,1)\n",
    "\n",
    "\n",
    "qc.h(0)\n",
    "\n",
    "qc.cx(0,1)\n",
    "\n",
    "\n",
    "qc.measure(0,0)\n",
    "\n",
    "\n",
    "\n",
    "print(qc)\n",
    "\n",
    "\n",
    "sim=AerSimulator()\n",
    "\n",
    "\n",
    "result=sim.run(\n",
    "    qc,\n",
    "    shots=1000\n",
    ").result()\n",
    "\n",
    "\n",
    "print(\n",
    "result.get_counts()\n",
    ")"
   ]
  }
 ],
